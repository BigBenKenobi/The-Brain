{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Brain explicit sharing approval",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "project_id",
    "evidence_sha256",
    "technologies",
    "rationale",
    "approved_at",
    "review_after",
    "permission",
    "evidence_status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "evidence_sha256": {
      "type": "string"
    },
    "technologies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "approved_at": {
      "type": "number"
    },
    "review_after": {
      "type": "number"
    },
    "permission": {
      "const": "shared"
    },
    "evidence_status": {
      "enum": [
        "proposal",
        "historical_record",
        "observed_implementation"
      ]
    }
  }
}

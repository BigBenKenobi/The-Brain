{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Brain snapshot",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "project_id",
    "created_at",
    "extractor",
    "files",
    "records",
    "evidence",
    "metrics",
    "coverage_warnings",
    "search_index",
    "project_types",
    "ai"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "number"
    },
    "extractor": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "record.schema.json"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "status"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "status": {
            "enum": [
              "excluded_directory",
              "excluded",
              "sensitive",
              "unsupported",
              "unprocessed",
              "inaccessible",
              "retained",
              "duplicate"
            ]
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "metrics": {
      "type": "object"
    },
    "coverage_warnings": {
      "type": "array"
    },
    "search_index": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "project_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ai": {
      "type": "object"
    },
    "historical": {
      "type": "boolean"
    },
    "excluded_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "processing_budgets": {
      "type": "object"
    },
    "consolidation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "project_id",
          "snapshot"
        ],
        "properties": {
          "project_id": {
            "type": "string",
            "format": "uuid"
          },
          "snapshot": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  }
}

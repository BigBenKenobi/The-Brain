{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Snapshot-bound knowledge retirement assessment",
  "type": "object",
  "required": [
    "project_id",
    "snapshot",
    "reviewed_at",
    "goal",
    "summary",
    "known_gaps",
    "evidence_checks",
    "assessment_only",
    "deletion_authorized"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "snapshot": {
      "type": "string",
      "format": "uuid"
    },
    "reviewed_at": {
      "type": "number"
    },
    "goal": {
      "const": "preserve_useful_knowledge_before_intentional_discard"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "known_gaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidence_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "record_id",
          "evidence",
          "retained_text_checked"
        ],
        "properties": {
          "record_id": {
            "type": "string"
          },
          "evidence": {
            "type": "object"
          },
          "retained_text_checked": {
            "const": true
          }
        }
      }
    },
    "assessment_only": {
      "const": true
    },
    "deletion_authorized": {
      "const": false
    }
  }
}
